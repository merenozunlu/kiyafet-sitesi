# ---- API ----
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:5173

# Veri kaynağı: memory (varsayılan, DB gerektirmez) | prisma (PostgreSQL)
DATA_SOURCE=prisma
# memory modunda verileri JSON dosyasına yazarak sunucu yeniden başlasa da korur (opsiyonel)
DATA_PERSIST_FILE=./.data/store.json

# PostgreSQL (yalnızca DATA_SOURCE=prisma iken gerekli)
DATABASE_URL="file:./dev.db"

# JWT (üretimde en az 32 karakterlik rastgele değerler kullanın)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# İlk yönetici hesabı (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
# Demo müşteri (seed, yalnızca development)
DEMO_CUSTOMER_EMAIL=musteri@example.com
DEMO_CUSTOMER_PASSWORD=Musteri12345

# Ödeme sağlayıcısı: mock | iyzico
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Yüklemeler
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:4000

# ---- WEB ----
VITE_API_URL=http://localhost:4000/api/v1
